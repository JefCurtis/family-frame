{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "photo-frame-dashboard",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  // The Vite plugin builds the dashboard into the asset bundle; the Worker handles /api/*.
  "assets": { "binding": "ASSETS", "run_worker_first": ["/", "/index.html"] },
  // Run `npx wrangler kv namespace create CALENDAR`, then replace this placeholder.
  "kv_namespaces": [{ "binding": "CALENDAR", "id": "00000000000000000000000000000000" }],
  // Agent messages use one hibernating SQLite-backed Durable Object.
  "durable_objects": { "bindings": [{ "name": "MESSAGES", "class_name": "MessageRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MessageRoom"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  // Resize shared-album and saved-recipe images before they reach the frame.
  "images": { "binding": "IMAGES" },
  "vars": {
    "TODOIST_GROCERY_PROJECT": "Groceries",
    "TODOIST_TODO_PROJECT": "To-do",
    "WEATHER_UNIT": "celsius"
    // Add WEATHER_LAT, WEATHER_LON and DISPLAY_TZ here, or store them as Worker secrets.
  },
  "observability": { "enabled": true }
}

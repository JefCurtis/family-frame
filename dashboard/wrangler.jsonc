{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "photo-frame-dashboard",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  // The Vite plugin builds the dashboard into the asset bundle; the Worker only handles /api/*.
  // The Worker serves the page itself (to mark it no-store); everything else is a plain asset.
  "assets": { "binding": "ASSETS", "run_worker_first": ["/", "/index.html"] },
  // Created on the first deploy (2026-10-12) as "photo-frame-dashboard-calendar".
  "kv_namespaces": [{ "binding": "CALENDAR", "id": "76930d90f50042dbaacec1e1b578e412" }],
  // Agent messages: one SQLite-backed Durable Object holding the list and the frames' WebSockets
  // (hibernation API, so idle connections cost nothing). See worker/messages.js.
  "durable_objects": { "bindings": [{ "name": "MESSAGES", "class_name": "MessageRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MessageRoom"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  // Resizes photos of saved recipes once, when saved (worker/recipes.js).
  "images": { "binding": "IMAGES" },
  // Todoist project names shown as the Groceries and Tasks lists.
  "vars": { "TODOIST_GROCERY_PROJECT": "Grocery List", "TODOIST_TODO_PROJECT": "Household" },
  "observability": { "enabled": true }
}
